android_app {
    name: "FCNTParts",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: ["src/**/*.java", "src/**/*.aidl"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: ["privapp-permissions-fcntparts.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-fcntparts.xml",
    src: "privapp-permissions-fcntparts.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
