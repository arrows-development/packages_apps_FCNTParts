<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="exlider_intro"
        android:title="@string/exlider_summary" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="exlider"
        android:title="@string/exlider_main_switch_title"
        android:persistent="false"
        android:defaultValue="false" />

    <ListPreference
        android:key="exlider_toggle_gesture"
        android:title="@string/exlider_toggle_gesture_title"
        android:dialogTitle="@string/exlider_toggle_gesture_title"
        android:entries="@array/exlider_toggle_gesture_entries"
        android:entryValues="@array/exlider_toggle_gesture_values"
        android:persistent="false"
        android:defaultValue="0"
        settings:useSimpleSummaryProvider="true" />

    <jp.project2by2.fcntparts.exlider.ExliderSpeedPreference
        android:key="exlider_scroll_speed"
        android:title="@string/exlider_scroll_speed_title"
        android:summary="@string/exlider_scroll_speed_summary"
        android:max="100"
        android:defaultValue="30"
        settings:continuousUpdates="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="exlider_intro_2"
        android:title="@string/exlider_summary_2" />

</PreferenceScreen>
