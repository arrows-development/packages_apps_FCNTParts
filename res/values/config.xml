<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Action Key -->
    <bool name="config_actionKeySupported">false</bool>

    <!-- Exlider -->
    <bool name="config_exliderSupported">true</bool>

    <!-- Exlider: still touch (ms) required to arm the scroll mode toggle.
         The toggle happens when the finger is released afterwards. -->
    <integer name="config_exliderLongTapTime">500</integer>

    <!-- Exlider: holding still for this long (ms) after arming cancels the toggle.
         While in scroll mode, holding still for this long and releasing exits it. -->
    <integer name="config_exliderLongTapCancelTime">1500</integer>

    <!-- Exlider: scroll mode is left after this long (ms) without a touch. 0 disables. -->
    <integer name="config_exliderScrollModeTimeout">30000</integer>

    <!-- Exlider: slide distance (raw HAL units) to start scrolling after touching,
         to stop / reverse while scrolling, and to start again after resting. -->
    <integer name="config_exliderGearThresholdStart">45</integer>
    <integer name="config_exliderGearThresholdChange">15</integer>
    <integer name="config_exliderGearThresholdIdle">12</integer>

    <!-- Exlider: a contact is a tap when it is released within this time (ms)
         without sliding more than config_exliderTapSlop (raw HAL units). -->
    <integer name="config_exliderTapTimeout">300</integer>
    <integer name="config_exliderTapSlop">30</integer>

    <!-- Exlider: maximum time (ms) between the release of the first tap and the
         touch of the second tap of a double tap. -->
    <integer name="config_exliderDoubleTapTimeout">400</integer>

    <!-- Exlider: without a finger-up key, the finger is considered lifted when the
         HAL reports no frame for this long (ms) in double tap mode. -->
    <integer name="config_exliderTapLiftGap">100</integer>

    <!-- Exlider: invert the slide direction reported by the HAL. -->
    <bool name="config_exliderInvertDirection">false</bool>
</resources>
